# JioSaavn API Configuration & Credentials (Example Template)
# Copy this file to .env and configure your environment credentials

# JioSaavn Media Decryption DES Key
VITE_JIOSAAVN_DES_KEY=

# JioSaavn API Base Endpoint (Proxy path)
VITE_JIOSAAVN_API_BASE=/api/saavn

# JioSaavn Direct API URL
VITE_JIOSAAVN_API_URL=https://www.jiosaavn.com/api.php
JIOSAAVN_API_URL=https://www.jiosaavn.com/api.php
